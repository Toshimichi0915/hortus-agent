{
  "name": "hortus-agent",
  "version": "0.1.0",
  "private": true,
  "description": "hortusd (daemon, vault, proxy, console), hortus-agent (Worker/Planner), hortus (CLI), dof",
  "type": "module",
  "bin": {
    "hortusd": "dist/bin/hortusd.js",
    "hortus": "dist/bin/hortus.js",
    "hortus-agent": "dist/bin/hortus-agent.js",
    "dof": "dist/bin/dof.js"
  },
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "sh scripts/build.sh",
    "test": "sh scripts/build.sh && node --test 'dist/**/*.test.js'",
    "lint": "biome lint",
    "format": "biome format --write",
    "web": "VITE_MOCK=1 vite web",
    "web:build": "tsc -p web && vite build web"
  },
  "dependencies": {
    "@hortus/core": "^1.2.0",
    "@simplewebauthn/server": "^14.0.0",
    "croner": "^11.0.0",
    "quickjs-emscripten": "^0.32.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.16.1"
}
