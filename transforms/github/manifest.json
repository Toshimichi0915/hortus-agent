{
  "name": "github",
  "vars": { "host": "github.com", "api": "api.github.com", "host_api": "{host}/api/v3" },
  "credentials": {
    "github": {
      "type": "github-app",
      "hosts": ["{api}", "{host}", "uploads.github.com"],
      "locations": ["header:Authorization", "basic:password"]
    },
    "github-webhook": { "type": "webhook-secret", "hosts": [], "locations": [] }
  },
  "scope": [
    "{api}/graphql",
    "{host}/api/graphql",
    "{api}/repos/{project}",
    "{api}/repos/{project}/**",
    "{host}/{project}.git/**",
    "{host}/{project}/**",
    "uploads.github.com/repos/{project}/**"
  ],
  "consequential": [
    "DELETE {api}/**",
    "POST {host}/**/git-receive-pack",
    "PUT {api}/repos/*/*/pulls/*/merge",
    "PUT {api}/repos/*/*/pulls/*/update-branch",
    "POST {api}/repos/*/*/merges",
    "POST {api}/repos/*/*/merge-upstream",
    "PUT {api}/repos/*/*/contents/**",
    "POST {api}/repos/*/*/git/refs",
    "PATCH {api}/repos/*/*/git/refs/**",
    "POST {api}/user/repos",
    "POST {api}/orgs/*/repos",
    "POST {api}/repos/*/*/forks",
    "POST {api}/repos/*/*/security-advisories/*/forks",
    "PUT {api}/repos/*/*/import",
    "PATCH {api}/repos/*/*/import",
    "POST {api}/repos/*/*/generate",
    "POST {api}/repos/*/*/transfer",
    "PATCH {api}/repos/*/*",
    "POST {api}/repos/*/*/branches/**/rename",
    "POST {api}/repos/*/*/releases",
    "PATCH {api}/repos/*/*/releases/*",
    "* {api}/graphql",
    "* {host}/api/graphql"
  ]
}
