{
  "name": "slack",
  "credentials": {
    "slack": { "type": "token", "hosts": ["slack.com", "files.slack.com"], "locations": ["header:Authorization"] },
    "slack-app": { "type": "token", "hosts": ["slack.com"], "locations": ["header:Authorization"] }
  },
  "consequential": [
    "* slack.com/api/chat.delete",
