{
  "name": "telegram",
  "credentials": {
    "telegram": { "type": "token", "hosts": ["api.telegram.org"], "locations": ["path:/bot{}/"] }
  },
  "consequential": [
    "* api.telegram.org/bot*/delete*",
    "* api.telegram.org/bot*/leaveChat",
    "* api.telegram.org/bot*/banChatMember",
    "* api.telegram.org/bot*/setWebhook",
    "* api.telegram.org/bot*/logOut"
  ]
}
