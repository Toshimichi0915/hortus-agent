{
  "name": "ollama",
  "credentials": {
    "ollama": {
      "type": "token",
      "hosts": ["ollama.com"],
      "locations": ["header:Authorization"]
    }
  },
  "consequential": [
    "DELETE **",
    "POST **/files",
    "POST **/uploads",
    "POST **/batches",
    "POST **/fine_tuning/**",
    "POST **/organization/**",
    "POST **/api/create",
    "POST **/api/copy",
    "POST **/api/push",
    "POST **/api/blobs/**",
    "POST **/keys",
    "PATCH **/keys/**",
    "POST **/credits/**"
  ]
}
