{
  "name": "gitlab",
  "vars": {
    "host": "gitlab.com",
    "api": "gitlab.com/api/v4",
    "host_api": "{host}/api/v4"
  },
  "credentials": {
    "gitlab": {
      "type": "token",
      "hosts": ["{host}"],
      "locations": ["header:PRIVATE-TOKEN", "header:Authorization", "basic:password"]
    },
    "gitlab-webhook": {
      "type": "webhook-secret",
      "hosts": [],
      "locations": []
    }
  },
  "scope": ["{host}/api/v4/projects/{project}", "{host}/api/v4/projects/{project}/**", "{host}/{project}.git/**"],
  "consequential": [
    "DELETE {host}/api/v4/**",
    "GET {host}/api/v4/projects/*/**variables**",
    "GET {host}/api/v4/projects/*/secure_files**",
    "POST {host}/**/git-receive-pack",
    "PUT {host}/api/v4/projects/*/merge_requests/*/merge",
    "PUT {host}/api/v4/projects/*/merge_requests/*/rebase",
    "POST {host}/api/v4/projects/*/merge_trains/**",
    "POST {host}/api/v4/projects/*/repository/**",
    "PUT {host}/api/v4/projects/*/repository/**",
    "POST {host}/api/v4/projects",
    "POST {host}/api/v4/projects/*/releases",
    "PUT {host}/api/v4/projects/*",
    "POST {host}/api/v4/projects/*/transfer",
    "PUT {host}/api/v4/projects/*/transfer",
    "POST {host}/api/v4/projects/*/fork",
    "POST {host}/api/v4/projects/*/import/**",
    "POST {host}/api/v4/projects/*/jobs/*/erase",
    "POST {host}/api/v4/projects/*/housekeeping",
    "POST {host}/api/v4/projects/*/ml/mlflow/**/delete",
    "POST {host}/api/v4/projects/*/members**",
    "PUT {host}/api/v4/projects/*/members**",
    "POST {host}/api/v4/projects/*/hooks**",
    "PUT {host}/api/v4/projects/*/hooks**",
    "POST {host}/api/v4/projects/*/deploy_keys**",
    "PUT {host}/api/v4/projects/*/deploy_keys**",
    "POST {host}/api/v4/projects/*/variables**",
    "PUT {host}/api/v4/projects/*/variables**",
    "POST {host}/api/v4/projects/*/protected_branches**",
    "PUT {host}/api/v4/projects/*/protected_branches**",
    "POST {host}/api/v4/projects/*/access_tokens**",
    "PUT {host}/api/v4/projects/*/access_tokens**",
    "POST {host}/api/v4/projects/*/share**",
    "PUT {host}/api/v4/projects/*/share**",
    "POST {host}/api/v4/projects/*/protected_tags**",
    "PUT {host}/api/v4/projects/*/protected_tags**",
    "POST {host}/api/v4/projects/*/invitations**",
    "PUT {host}/api/v4/projects/*/invitations**",
    "POST {host}/api/v4/projects/*/remote_mirrors**",
    "PUT {host}/api/v4/projects/*/remote_mirrors**",
    "POST {host}/api/v4/projects/*/push_rule**",
    "PUT {host}/api/v4/projects/*/push_rule**",
    "POST {host}/api/v4/projects/*/approval_rules**",
    "PUT {host}/api/v4/projects/*/approval_rules**",
    "POST {host}/api/v4/projects/*/approvals",
    "PUT {host}/api/v4/projects/*/approvals",
    "POST {host}/api/v4/projects/*/integrations**",
    "PUT {host}/api/v4/projects/*/integrations**",
    "POST {host}/api/v4/projects/*/services**",
    "PUT {host}/api/v4/projects/*/services**",
    "POST {host}/api/v4/projects/*/deploy_tokens**",
    "PUT {host}/api/v4/projects/*/deploy_tokens**",
    "POST {host}/api/v4/projects/*/runners**",
    "PUT {host}/api/v4/projects/*/runners**",
    "POST {host}/api/v4/projects/*/archive",
    "POST {host}/api/v4/projects/*/unarchive",
    "PATCH {host}/api/v4/projects/*/**"
  ]
}
