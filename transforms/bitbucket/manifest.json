{
  "name": "bitbucket",
  "credentials": {
    "bitbucket": {
      "type": "token",
      "hosts": ["api.bitbucket.org", "bitbucket.org"],
      "locations": ["header:Authorization", "basic:password"]
    },
    "bitbucket-webhook": {
      "type": "webhook-secret",
      "hosts": [],
      "locations": []
    }
  },
  "scope": [
    "api.bitbucket.org/2.0/repositories/{project}",
    "api.bitbucket.org/2.0/repositories/{project}/**",
    "bitbucket.org/{project}.git/**"
  ],
  "consequential": [
    "DELETE api.bitbucket.org/**",
    "POST bitbucket.org/**/git-receive-pack",
    "POST api.bitbucket.org/2.0/repositories/*/*/pullrequests/*/merge",
    "POST api.bitbucket.org/2.0/repositories/*/*/src",
    "POST api.bitbucket.org/2.0/repositories/*/*/src/**",
    "POST api.bitbucket.org/2.0/repositories/*/*/refs/**",
    "POST api.bitbucket.org/2.0/repositories/*/*",
    "POST api.bitbucket.org/2.0/repositories/*/*/pullrequests/*/merge",
    "PUT api.bitbucket.org/2.0/repositories/*/*",
    "POST api.bitbucket.org/2.0/repositories/*/*/hooks**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/hooks**",
    "POST api.bitbucket.org/2.0/repositories/*/*/deploy-keys**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/deploy-keys**",
    "POST api.bitbucket.org/2.0/repositories/*/*/permissions-config**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/permissions-config**",
    "POST api.bitbucket.org/2.0/repositories/*/*/branch-restrictions**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/branch-restrictions**",
    "POST api.bitbucket.org/2.0/repositories/*/*/pipelines_config**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/pipelines_config**",
    "POST api.bitbucket.org/2.0/repositories/*/*/forks**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/forks**",
    "POST api.bitbucket.org/2.0/repositories/*/*/default-reviewers**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/default-reviewers**",
    "POST api.bitbucket.org/2.0/repositories/*/*/branching-model/settings**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/branching-model/settings**",
    "POST api.bitbucket.org/2.0/repositories/*/*/override-settings**",
    "PUT api.bitbucket.org/2.0/repositories/*/*/override-settings**"
  ]
}
